<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Curicó Turístico — Guía de lugares para visitar</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Caveat:wght@600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #FFFFFF;
    --bg-raised: #F6F3EC;
    --ink: #2B1B14;
    --ink-soft: #6B4F3F;
    --wine: #A3223F;
    --wine-deep: #6E1730;
    --wine-bright: #D94F6B;
    --green: #4CA758;
    --green-deep: #2E6B38;
    --green-bright: #6DBE77;
    --gold: #E1A32E;
    --gold-deep: #B87D18;
    --line: #EBD2A6;
    --paper: #FFFFFF;
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #211610;
      --bg-raised: #2B1D14;
      --ink: #FBEFDD;
      --ink-soft: #D8C1A8;
      --wine: #E8748C;
      --wine-deep: #F3A2B2;
      --wine-bright: #F08CA1;
      --green: #6DBE77;
      --green-deep: #94D39C;
      --green-bright: #7FCB89;
      --gold: #F0BA5C;
      --gold-deep: #F5CB80;
      --line: #4A382A;
      --paper: #2B1D14;
    }
  }
  :root[data-theme="dark"] {
    --bg: #211610;
    --bg-raised: #2B1D14;
    --ink: #FBEFDD;
    --ink-soft: #D8C1A8;
    --wine: #E8748C;
    --wine-deep: #F3A2B2;
    --wine-bright: #F08CA1;
    --green: #6DBE77;
    --green-deep: #94D39C;
    --green-bright: #7FCB89;
    --gold: #F0BA5C;
    --gold-deep: #F5CB80;
    --line: #4A382A;
    --paper: #2B1D14;
  }
  html { scroll-behavior: smooth; scroll-padding-top: calc(72px + env(safe-area-inset-top, 0px)); }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: "Montserrat", -apple-system, BlinkMacSystemFont, sans-serif;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3, .display {
    font-family: "Montserrat", -apple-system, BlinkMacSystemFont, sans-serif;
    font-weight: 800;
    line-height: 1.06;
    margin: 0;
    letter-spacing: -0.015em;
  }
  a { color: inherit; }
  img { max-width: 100%; }

  .wrap { max-width: 1040px; margin: 0 auto; padding: 0 28px; }
  @media (max-width: 640px) { .wrap { padding: 0 20px; } }

  /* ---------- Nav ---------- */
  .nav {
    position: sticky; top: 0; z-index: 40;
    padding-top: env(safe-area-inset-top, 0px);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .nav-row {
    max-width: 1040px; margin: 0 auto; padding: 14px 28px;
    display: flex; align-items: center; justify-content: space-between;
    gap: 16px;
  }
  .nav-brand { display: flex; align-items: center; gap: 10px; font-family: "Montserrat", sans-serif; font-weight: 800; font-size: 1.05rem; text-decoration: none; color: var(--green-deep); }
  .nav-logo { height: 34px; width: auto; display: block; }
  .nav { border-bottom: 3px solid; border-image: linear-gradient(90deg, var(--wine), var(--gold), var(--green)) 1; }
  .footer-logo { height: 64px; width: auto; display: block; margin-bottom: 18px; }
  .tagline-script { font-family: "Caveat", cursive; font-weight: 700; color: var(--green); font-size: 1.3rem; }
  .nav-links { display: flex; gap: 22px; font-size: 0.92rem; list-style: none; margin: 0; padding: 0; }
  .nav-links a { text-decoration: none; color: var(--ink-soft); border-bottom: 1px solid transparent; padding-bottom: 2px; }
  .nav-links a:hover { color: var(--wine); border-color: var(--wine); }
  @media (max-width: 720px) { .nav-links { display: none; } }

  /* ---------- Hero ---------- */
  .hero { padding: 76px 0 56px; }
  .hero-eyebrow { color: var(--wine); font-size: 0.95rem; margin-bottom: 14px; }
  .hero h1 { font-size: clamp(2.4rem, 5vw, 3.6rem); max-width: 15ch; }
  .hero p.lead { max-width: 56ch; font-size: 1.15rem; color: var(--ink-soft); margin-top: 20px; }
  .hero-motif { margin-top: 44px; }

  /* palm frieze */
  .frieze { display: block; width: 100%; height: auto; }

  /* ---------- Stat strip ---------- */
  .stats {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 32px 0;
  }
  .stats-row {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px;
  }
  @media (max-width: 720px) { .stats-row { grid-template-columns: repeat(2, 1fr); } }
  .stat .num { font-family: "Montserrat", sans-serif; font-size: 2.1rem; font-weight: 800; color: var(--wine); }
  .stat:nth-child(2) .num { color: var(--green); }
  .stat:nth-child(3) .num { color: var(--gold-deep); }
  .stat:nth-child(4) .num { color: var(--wine); }
  .stat .lbl { font-size: 0.88rem; color: var(--ink-soft); margin-top: 4px; }

  /* ---------- Section shell ---------- */
  section { padding: 72px 0; }
  .section-head { max-width: 62ch; margin-bottom: 40px; }
  .kicker { color: var(--green); font-size: 0.95rem; margin-bottom: 10px; }
  .section-head h2 { font-size: clamp(1.7rem, 3.2vw, 2.3rem); }
  .section-head p { color: var(--ink-soft); margin-top: 14px; font-size: 1.02rem; max-width: 58ch; }

  /* ---------- Map ---------- */
  .map-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 20px;
  }
  .province-map { display: block; width: 100%; height: auto; border-radius: 3px; }
  .map-note { font-size: 0.86rem; color: var(--ink-soft); margin-top: 14px; }
  .map-legend { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 20px; }
  .map-legend a {
    display: flex; align-items: center; gap: 10px;
    text-decoration: none; font-size: 0.92rem;
    padding: 8px 4px;
  }
  .map-legend .dot { width: 11px; height: 11px; border-radius: 50%; flex: none; }
  .map-legend a span.go { color: var(--wine); text-decoration: underline; text-underline-offset: 2px; margin-left: 4px; white-space: nowrap; }

  /* ---------- Route (lugares) ---------- */
  .route { position: relative; }
  .stop {
    position: relative;
    padding: 0 0 64px 56px;
    border-left: 2px dotted var(--line);
    margin-left: 15px;
  }
  .stop:last-child { border-left: 2px dotted transparent; padding-bottom: 0; }
  .stop-num {
    position: absolute; left: -16px; top: 0;
    width: 32px; height: 32px; border-radius: 50%;
    background: var(--wine); color: var(--paper);
    display: flex; align-items: center; justify-content: center;
    font-family: "Montserrat", sans-serif; font-weight: 800; font-size: 0.95rem;
  }
  .stop-loc { color: var(--ink-soft); font-size: 0.92rem; margin-top: 6px; }
  .stop h3 { font-size: 1.5rem; margin-top: 14px; }
  .stop-art { margin-top: 18px; border-radius: 4px; overflow: hidden; border: 1px solid var(--line); }
  .stop-art svg { display: block; width: 100%; height: auto; }
  .stop-photos {
    margin-top: 18px; display: grid; grid-template-columns: 1.4fr 1fr; gap: 8px;
    border-radius: 4px; overflow: hidden;
  }
  .stop-photos .photo-main { width: 100%; height: 100%; min-height: 220px; object-fit: cover; display: block; }
  .stop-photos .photo-side { display: grid; grid-template-rows: 1fr 1fr; gap: 8px; }
  .stop-photos .photo-side img { width: 100%; height: 100%; object-fit: cover; display: block; }
  @media (max-width: 560px) {
    .stop-photos { grid-template-columns: 1fr; }
    .stop-photos .photo-main { min-height: 200px; }
    .stop-photos .photo-side { grid-template-columns: 1fr 1fr; grid-template-rows: none; }
  }

  .mini-gallery {
    margin-top: 14px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px;
  }
  .mini-gallery img { width: 100%; height: 110px; object-fit: cover; border-radius: 3px; display: block; }
  .mini-gallery.mini-gallery-1 { grid-template-columns: 1fr; }
  .mini-gallery.mini-gallery-1 img { height: 200px; }
  @media (max-width: 560px) {
    .mini-gallery { grid-template-columns: 1fr 1fr; }
  }
  .stop .dates { color: var(--wine); font-size: 0.9rem; margin-top: 8px; }
  .stop p.intro { margin-top: 14px; max-width: 60ch; color: var(--ink-soft); }

  details.item {
    border-top: 1px solid var(--line);
    padding: 14px 0;
  }
  details.item:last-of-type { border-bottom: 1px solid var(--line); }
  details.item summary {
    cursor: pointer; list-style: none;
    display: flex; align-items: baseline; justify-content: space-between; gap: 16px;
    font-weight: 600;
  }
  details.item summary::-webkit-details-marker { display: none; }
  details.item summary::after {
    content: "+"; font-family: "Montserrat", sans-serif; font-size: 1.3rem; color: var(--wine);
    flex: none;
  }
  details.item[open] summary::after { content: "–"; }
  details.item .body { margin-top: 10px; color: var(--ink-soft); max-width: 62ch; }
  details.item .names { margin-top: 10px; padding-left: 20px; color: var(--ink-soft); }
  .item-list { margin-top: 30px; }

  /* ---------- Timeline ---------- */
  .timeline { margin-top: 8px; }
  .tl-row {
    display: grid; grid-template-columns: 160px 1fr; gap: 20px;
    padding: 13px 0; border-top: 1px solid var(--line);
  }
  .tl-row:last-child { border-bottom: 1px solid var(--line); }
  .tl-date { font-weight: 600; color: var(--wine); font-size: 0.95rem; }
  .tl-event { color: var(--ink-soft); }
  @media (max-width: 560px) { .tl-row { grid-template-columns: 1fr; gap: 4px; } }

  /* ---------- Gastronomy / territory cards ---------- */
  .flavor-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  @media (max-width: 760px) { .flavor-grid { grid-template-columns: 1fr; } }
  .flavor-art { border-radius: 4px; overflow: hidden; border: 1px solid var(--line); margin-bottom: 16px; }
  .flavor-art svg { display: block; width: 100%; height: auto; }
  .flavor h3 { font-size: 1.2rem; margin-bottom: 10px; }
  .flavor p { color: var(--ink-soft); font-size: 0.97rem; }
  .flavor .tag { color: var(--green); font-size: 0.85rem; margin-bottom: 8px; display: block; }

  .locality-band {
    display: flex; flex-wrap: wrap; gap: 12px 28px; margin-top: 10px;
  }
  .locality-band .place { font-family: "Montserrat", sans-serif; font-size: 1.05rem; }
  .locality-band .place small { display: block; font-family: "Montserrat", sans-serif; color: var(--ink-soft); font-size: 0.82rem; font-weight: 400; margin-top: 2px; }

  /* ---------- Positioning quote ---------- */
  .quote-block {
    background: var(--wine); color: var(--paper);
    border-radius: 4px; padding: 48px 36px;
  }
  :root[data-theme="dark"] .quote-block, @media (prefers-color-scheme: dark) { }
  .quote-block h2 { font-size: clamp(1.6rem, 3.4vw, 2.2rem); max-width: 22ch; }
  .quote-block p { margin-top: 18px; max-width: 58ch; opacity: 0.92; font-size: 1.02rem; }

  footer {
    border-top: 1px solid var(--line);
    padding: 40px 0 calc(40px + env(safe-area-inset-bottom, 0px));
    font-size: 0.86rem; color: var(--ink-soft);
  }
  footer .sources { margin-top: 10px; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }

  /* ---------- Language toggle ---------- */
  body.lang-es .lang-en { display: none !important; }
  body.lang-en .lang-es { display: none !important; }
  .lang-btn {
    font-family: "Montserrat", sans-serif; font-weight: 800; font-size: 0.82rem;
    border: 1.5px solid var(--wine); color: var(--wine); background: transparent;
    border-radius: 20px; padding: 6px 14px; cursor: pointer; letter-spacing: 0.02em;
  }
  .lang-btn:hover { background: var(--wine); color: var(--paper); }

  /* ---------- Utility bar (mimics curico.cl chrome) ---------- */
  .util-bar {
    background: #333333; color: #EDEDED;
    font-family: "Montserrat", sans-serif; font-size: 0.78rem; font-weight: 600;
    padding-top: env(safe-area-inset-top, 0px);
  }
  .util-row {
    max-width: 1200px; margin: 0 auto; padding: 8px 28px;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
  }
  .util-left { display: flex; align-items: center; gap: 8px; }
  .util-left a { color: var(--paper); text-decoration: none; display: flex; align-items: center; gap: 6px; }
  .util-dot { width: 20px; height: 20px; border-radius: 50%; background: var(--green); display: inline-flex; align-items: center; justify-content: center; font-size: 0.7rem; color: var(--paper); flex: none; }
  .util-right { display: flex; align-items: center; gap: 10px; }
  .util-right a { color: var(--paper); text-decoration: none; width: 22px; height: 22px; border-radius: 4px; background: rgba(255,255,255,0.14); display: flex; align-items: center; justify-content: center; font-size: 0.75rem; }
  .util-right a:hover { background: var(--green); }
  @media (max-width: 640px) { .util-row { padding: 8px 20px; } .util-left span.util-label { display: none; } }

  /* ---------- Menu bar (tabs like curico.cl) ---------- */
  .menu-bar { background: var(--paper); border-bottom: 1px solid var(--line); }
  .menu-row { max-width: 1200px; margin: 0 auto; padding: 0 28px; display: flex; align-items: center; gap: 4px; overflow-x: auto; }
  .menu-row a {
    display: block; padding: 16px 18px; font-family: "Montserrat", sans-serif; font-weight: 700;
    font-size: 0.92rem; color: var(--ink-soft); text-decoration: none; white-space: nowrap;
    border-bottom: 3px solid transparent;
  }
  .menu-row a:hover, .menu-row a.active { color: var(--green); border-bottom-color: var(--green); }
  .menu-row a.active { color: var(--wine); border-bottom-color: var(--wine); }

  /* ---------- Hero CTA pill (mimics "ver más" button) ---------- */
  .hero { position: relative; }
  .hero-cta {
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--green); color: var(--paper); text-decoration: none;
    font-family: "Montserrat", sans-serif; font-weight: 800; font-size: 0.95rem;
    padding: 10px 10px 10px 22px; border-radius: 999px; margin-top: 28px;
  }
  .hero-cta:hover { background: var(--green-deep); }
  .hero-cta .arrow {
    width: 30px; height: 30px; border-radius: 50%; background: var(--paper); color: var(--green);
    display: flex; align-items: center; justify-content: center; font-size: 1rem; flex: none;
  }
</style>
</head>
